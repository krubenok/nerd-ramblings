{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nerd-ramblings",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "nerd-ramblings.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
