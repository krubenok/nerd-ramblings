{
  "name": "nerd-ramblings",
  "version": "2.0.0",
  "private": true,
  "description": "Kyle Rubenok's personal technology blog.",
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:cloudflare": "pnpm fetch:resume && pnpm check",
    "preview": "astro preview",
    "sync": "astro sync",
    "lint": "astro sync && oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm build",
    "fetch:resume": "node scripts/fetch-resume.mjs",
    "deploy": "pnpm check && wrangler deploy",
    "deploy:preview": "pnpm check && wrangler versions upload"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.9.1"
}
