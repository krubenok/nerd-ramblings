{
  "name": "nerd-ramblings",
  "version": "2.0.0",
  "private": true,
  "description": "Kyle Rubenok's personal technology blog.",
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "lint": "astro sync && oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run build",
    "deploy": "npm run check && wrangler deploy",
    "deploy:preview": "npm run check && wrangler versions upload"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "anymatch": {
      "picomatch": "2.3.2"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
