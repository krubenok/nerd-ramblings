---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, slugifyTag } from "../../lib/posts";

const COUNT_INCREMENT = 1,
 EMPTY_COUNT = 0,
 ENTRY_VALUE_INDEX = 1,
 SINGULAR_COUNT = 1,
 posts = await getPublishedPosts(),
 tagCounts = posts.reduce<Map<string, { label: string; count: number }>>((counts, post) => {
  for (const tag of post.data.tags) {
   const tagSlug = slugifyTag(tag),
    tagValue = counts.get(tagSlug);
   counts.set(tagSlug, {
     count: (tagValue?.count ?? EMPTY_COUNT) + COUNT_INCREMENT,
     label: tagValue?.label ?? tag,
    });
  }
  return counts;
}, new Map()),
 tags = [...tagCounts.entries()].sort((left, right) =>
  left[ENTRY_VALUE_INDEX].label.localeCompare(right[ENTRY_VALUE_INDEX].label),
);
---

<BaseLayout title="Topics" description="Browse Nerd Ramblings by topic.">
  <header class="page-header">
    <p class="eyebrow">Browse by subject</p>
    <h1>Topics</h1>
    <p>Follow a thread through the archive.</p>
  </header>

  <ul class="topic-grid">
    {
      tags.map(([slug, { label, count }]) => (
        <li>
          <a href={`/tags/${slug}`}>
            <span>{label}</span>
            <small>{count} {count === SINGULAR_COUNT ? "post" : "posts"}</small>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
