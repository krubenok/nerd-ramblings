---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const { Content, page } = await (async () => {
  const allPages = await getCollection("pages"),
    matchingPage = allPages.find(({ data }) => data.slug === "/working-with-kyle");

  if (!matchingPage) {
    throw new Error("The Working with Kyle page is missing from the pages content collection.");
  }

  return { page: matchingPage, ...(await render(matchingPage)) };
})();
---

<BaseLayout
  title="Working with Kyle"
  description="Kyle Rubenok's working style, communication preferences, and collaboration norms."
>
  <article class="prose">
    <header class="page-header">
      <p class="eyebrow">A working manual</p>
      <h1>{page.data.title}</h1>
    </header>
    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
