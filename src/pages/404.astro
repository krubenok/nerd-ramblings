---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page could not be found.">
  <section class="not-found">
    <p class="eyebrow">404 · Lost packet</p>
    <h1>This isn’t the page you were looking for.</h1>
    <p>The link may be old, or the address may have picked up a typo.</p>
    <a class="button" href="/">Return home</a>
  </section>
</BaseLayout>
