---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const { Content, page } = await (async () => {
  const allPages = await getCollection("pages"),
    matchingPage = allPages.find(({ data }) => data.slug === "/about");

  if (!matchingPage) {
    throw new Error("The about page is missing from the pages content collection.");
  }

  return { page: matchingPage, ...(await render(matchingPage)) };
})();
---

<BaseLayout title="About" description="About Kyle Rubenok and Nerd Ramblings.">
  <article class="prose">
    <header class="page-header">
      <p class="eyebrow">About the author</p>
      <h1>{page.data.title}</h1>
    </header>
    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
